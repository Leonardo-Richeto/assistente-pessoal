# Copie para ${COFRE_HOME}/.env (fora do git), chmod 600, e preencha.
# Ficha 11 de docs/regras-de-negocio.md; roteiro em docs/IMPLANTACAO.md ("Cofre (2b.3a)").

# --- Onde mora o estado (banco, chaves, anexos, identidade do Tailscale). ---
COFRE_HOME=/srv/cofre
COMPOSE_PROJECT_NAME=cofre
# Porta no loopback do host (conferência e túnel SSH).
PORTA_HOST=8030
# Dono dos arquivos de data/vaultwarden (o usuário do host que roda o backup: id -u / id -g).
COFRE_UID=1000
COFRE_GID=1000

# --- Tailscale: nó próprio, só Serve (nunca Funnel). ---
COMPOSE_PROFILES=tailscale
TS_NOME=cofre
# Só na primeira subida; depois a identidade fica em data/tailscale. Apague o valor depois.
TS_AUTHKEY=
# Endereço do cofre na tailnet (o nome do nó + o da tailnet): https://cofre.<tailnet>.ts.net
DOMINIO=

# --- Backup (cofre/scripts/exportar.sh) ---
# Mesma chave PÚBLICA do age do assistente.
AGE_DESTINATARIO=
# Vazio = ${COFRE_HOME}/backups. No i7: /srv/backup-hd/cofre.
BACKUP_DESTINO=
