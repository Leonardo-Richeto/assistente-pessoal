# Copie para ${PAPERLESS_HOME}/.env (fora do git) e preencha. Senhas: openssl rand -hex 32.
# Ficha 6 de docs/regras-de-negocio.md; roteiro em docs/IMPLANTACAO.md (Fase 2.1).

# --- Onde mora o estado (documentos, banco, consumo). ---
PAPERLESS_HOME=/srv/paperless
COMPOSE_PROJECT_NAME=paperless
# Porta da interface web no loopback do host (túnel SSH para abrir de fora).
PORTA_HOST=8010

# --- Senhas ---
PAPERLESS_DBPASS=
PAPERLESS_SECRET_KEY=
# Superusuário, criado na primeira subida. Só para a interface web; nunca vira token de assistente.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

# --- Pessoas: um usuário comum para cada (preparar.sh cria, conferir.sh confere). ---
# O primeiro recebe também o que cair na raiz de consumir/ (Ficha 6, decisão 2).
USUARIOS=leonardo nathalia

# --- Redes das instâncias do assistente (iguais a <COMPOSE_PROJECT_NAME do assistente>-paperless). ---
REDE_PRINCIPAL=assistente-paperless
REDE_NATHALIA=assistente-nathalia-paperless

# --- Consumo: 0 = inotify (Linux); no Mac, 10. ---
PAPERLESS_CONSUMER_POLLING=0

# --- Backup (paperless/scripts/exportar.sh) ---
# Mesma chave PÚBLICA do age do assistente.
AGE_DESTINATARIO=
# Vazio = ${PAPERLESS_HOME}/backups. No i7: /srv/backup-hd/paperless.
BACKUP_DESTINO=
