# Copie para ${CAMERAS_HOME}/.env (fora do git), chmod 600, e preencha.
# Ficha 18 de docs/regras-de-negocio.md; roteiro em docs/IMPLANTACAO.md ("Câmera (11)").

# --- Onde mora o estado (config, banco e gravações). ---
CAMERAS_HOME=/srv/cameras
COMPOSE_PROJECT_NAME=cameras
# Porta no loopback do host (conferência e túnel SSH).
PORTA_HOST=8971

# --- Câmera (reserva no DHCP do roteador para o MAC da interface em uso). ---
CAMERA_IP=
# Senha da câmera já no formato de URL: troque # por %23, @ por %40, : por %3A, / por %2F e % por %25.
# Ponha pelo editor (fora do histórico do shell).
CAMERA_SENHA=

# --- Rede de casa (Ficha 18, regra 5): IP fixo do i7 na rede local. Vazio = só loopback (teste no Mac). ---
ENDERECO_LAN=
PORTA_LAN=8971

# --- GPU integrada para decodificar o vídeo. No i7: /dev/dri/renderD128. Vazio = só CPU (Mac). ---
GPU_DRI=

# --- Teto da pasta de gravações em GB (Ficha 18, regra 7). ---
LIMITE_GRAVACOES_GB=80
