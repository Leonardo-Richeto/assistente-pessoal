[Unit]
Description=Commit diario do vault (so comita se houver mudanca)
# So ordem, sem Requires: quando os timers disparam juntos (Persistent=true depois de a maquina ficar desligada),
# o commit espera o backup das 03:15 acabar; falha do backup nao impede o commit.
After=network-online.target docker.service assistente-backup.service
Wants=network-online.target

[Service]
Type=oneshot
# Troque <usuario> pelo usuario dono de /srv/assistente/vault (o mesmo do Syncthing).
# Ele precisa estar no grupo docker: o gitleaks roda numa imagem Docker antes do commit (scripts/preparar_host.sh).
User=<usuario>
# Arquivo opcional: VAULT_PATH=/srv/assistente/vault e VAULT_PUSH=1 (veja docs/SYNCTHING.md).
EnvironmentFile=-/etc/default/vault-commit
Environment=VAULT_PATH=/srv/assistente/vault
ExecStart=/bin/bash /srv/assistente/app/deploy/vault/commit-diario.sh
# Duas varreduras do gitleaks de ate 15 min cada (GITLEAKS_TIMEOUT); depois disso o systemd para o servico.
TimeoutStartSec=30min
# Push precisa da chave SSH de deploy do usuario em ~/.ssh/vault_deploy ou em VAULT_SSH_CHAVE (no
# /etc/default/vault-commit); o script so aceita ssh no push (https e pasta local nao).
