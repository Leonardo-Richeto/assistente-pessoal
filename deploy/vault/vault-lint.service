[Unit]
Description=Lint diario do vault (so le; relatorio em /srv/assistente/logs/vault-lint/ultimo.md)

[Service]
Type=oneshot
# Troque <usuario> pelo usuario dono de /srv/assistente/vault (o mesmo do Syncthing).
User=<usuario>
Environment=VAULT_PATH=/srv/assistente/vault LINT_DIR=/srv/assistente/logs/vault-lint
ExecStart=/bin/bash /srv/assistente/app/deploy/vault/lint-diario.sh
