# Copie para .env e preencha. O .env NUNCA vai para o git.
# Gerar senhas/chaves:  openssl rand -base64 32

# --- Banco ---
SENHA_DONO=
SENHA_LEITURA=
SENHA_ESCRITA=

# --- Dono desta instância ---
NOME_USUARIO=Leonardo
# Porta local do servidor no host (outra instância na mesma máquina usa outra, ex.: 8001)
PORTA_HOST=8000

# --- Endereço público do MCP (Tailscale Funnel), sem barra no final ---
# Funnel 443 -> https://<maquina>.<tailnet>.ts.net ; segunda instância no 8443 -> ...ts.net:8443
PUBLIC_BASE_URL=https://maquina.tailnet.ts.net

# --- Login: github ou google ---
AUTH_PROVEDOR=github
# Callback em qualquer provedor: <PUBLIC_BASE_URL>/auth/callback

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGINS_PERMITIDOS=

# Google (Google Cloud Console -> Credenciais -> ID do cliente OAuth -> Aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAILS_PERMITIDOS=

# Chave que assina os tokens emitidos pelo servidor. Trocar a chave invalida os logins salvos.
JWT_SIGNING_KEY=

# Para onde o login pode devolver o cliente MCP, separado por vírgula. O claude.ai
# (https://claude.ai/api/mcp/auth_callback e o mesmo em claude.com) sempre entra; isto soma.
# Cada padrão precisa de caminho: https://exemplo.com sozinho vale para o host inteiro e é recusado.
AUTH_REDIRECTS_PERMITIDOS=

# Limite por IP de origem, por hora, nos endpoints públicos do login (resposta 429).
# /consent usa o do authorize; /auth/callback usa o do token.
LIMITE_REGISTER_POR_HORA=10
LIMITE_AUTHORIZE_POR_HORA=30
LIMITE_TOKEN_POR_HORA=60
# Teto por hora somando todos os IPs (quem troca de IP não escapa). /consent usa o do authorize.
LIMITE_GLOBAL_REGISTER_POR_HORA=100
LIMITE_GLOBAL_AUTHORIZE_POR_HORA=300
# De quem aceitar X-Forwarded-For (IPs ou redes, vírgula). Vazio = loopback e o gateway do container.
PROXIES_CONFIAVEIS=
# Dias até sumir um cliente registrado que nunca pegou token.
CLIENTES_TTL_DIAS=1

# --- Peças prontas (deixe vazio para não usar) ---
# Pasta do vault NO HOST; dentro do container vira /vault
VAULT_PATH=
# Paperless-ngx já rodando (URL vista de dentro do container) e token da API
PAPERLESS_URL=
PAPERLESS_API_KEY=

# --- Alternativa Cloudflare (só com --profile cloudflare) ---
CLOUDFLARE_TUNNEL_TOKEN=
