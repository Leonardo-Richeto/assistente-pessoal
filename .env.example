# Copie para .env e preencha. O .env NUNCA vai para o git.
# Gerar senhas/chaves:  openssl rand -base64 32

# --- Banco ---
SENHA_DONO=
SENHA_LEITURA=
SENHA_ESCRITA=

# --- Endereço público do MCP (o do tunnel), sem barra no final ---
PUBLIC_BASE_URL=https://mcp.seudominio.com.br

# --- OAuth (GitHub OAuth App) ---
# Callback do app no GitHub: <PUBLIC_BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Logins do GitHub que podem usar (separados por vírgula)
GITHUB_LOGINS_PERMITIDOS=
# Chave que assina os tokens emitidos pelo servidor
JWT_SIGNING_KEY=

# --- Peças prontas (deixe vazio para não usar) ---
# Pasta do vault NO HOST; dentro do container vira /vault
VAULT_PATH=
# Paperless-ngx já rodando (URL vista de dentro do container) e token da API
PAPERLESS_URL=
PAPERLESS_API_KEY=

# --- Tunnel (só com --profile cloudflare) ---
CLOUDFLARE_TUNNEL_TOKEN=
