# Copie para ${ASSISTENTE_HOME}/.env (fora do repositório) e preencha. O .env NUNCA vai para o git.
# Os scripts recusam rodar se faltar alguma variável desta lista (mesmo as que podem ficar vazias).
# Gerar senhas/chaves:  openssl rand -base64 48

# --- Onde mora o estado (banco, vault, sessões, backups). Nada de caminho fixo no código. ---
# Produção: /srv/assistente. Teste no Windows: C:/caminho/da/pasta (barras normais).
ASSISTENTE_HOME=/srv/assistente
# Nome do projeto no Docker (containers "assistente-postgres-1" etc.). Segunda instância: outro nome.
COMPOSE_PROJECT_NAME=assistente
# Perfis do compose: "tailscale" liga o nó com Funnel (só na produção). Vazio = só local.
COMPOSE_PROFILES=

# --- Banco ---
SENHA_DONO=
SENHA_LEITURA=
SENHA_ESCRITA=

# --- Dono desta instância ---
NOME_USUARIO=Leonardo
# Porta local do servidor no host (outra instância na mesma máquina usa outra, ex.: 8001)
PORTA_HOST=8000

# --- Tailscale em container (perfil "tailscale") ---
# Nome fixo do nó: a URL fica https://<TS_NOME>.<tailnet>.ts.net em qualquer máquina e rede.
TS_NOME=assistente
# Chave de autenticação (painel do Tailscale -> Settings -> Keys). Só vale na primeira subida;
# depois a identidade fica em data/tailscale. Pode apagar o valor depois que o nó entrar.
TS_AUTHKEY=

# --- Endereço público do MCP (Tailscale Funnel), sem barra no final ---
PUBLIC_BASE_URL=https://assistente.tailnet.ts.net

# --- Login: google (principal) ou github ---
AUTH_PROVEDOR=google
# Callback em qualquer provedor: <PUBLIC_BASE_URL>/auth/callback

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGINS_PERMITIDOS=

# Google (Google Cloud Console -> Credenciais -> ID do cliente OAuth -> Aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAILS_PERMITIDOS=

# Chave que assina os tokens emitidos pelo servidor. Trocar a chave invalida os logins salvos.
JWT_SIGNING_KEY=

# Para onde o login pode devolver o cliente MCP, separado por vírgula. O claude.ai
# (https://claude.ai/api/mcp/auth_callback e o mesmo em claude.com) sempre entra; isto soma.
# Cada padrão precisa de caminho: https://exemplo.com sozinho vale para o host inteiro e é recusado.
AUTH_REDIRECTS_PERMITIDOS=

# Limite por IP de origem, por hora, nos endpoints públicos do login (resposta 429).
# /consent usa o do authorize; /auth/callback usa o do token.
LIMITE_REGISTER_POR_HORA=10
LIMITE_AUTHORIZE_POR_HORA=30
LIMITE_TOKEN_POR_HORA=60
# Teto por hora somando todos os IPs (quem troca de IP não escapa). /consent usa o do authorize.
LIMITE_GLOBAL_REGISTER_POR_HORA=100
LIMITE_GLOBAL_AUTHORIZE_POR_HORA=300
# De quem aceitar X-Forwarded-For (IPs ou redes, vírgula). Vazio = loopback e o gateway do container.
# Com o Tailscale em container (mesma rede do servidor), o Funnel chega por 127.0.0.1: deixe vazio.
PROXIES_CONFIAVEIS=
# Dias até sumir um cliente registrado que nunca pegou token.
CLIENTES_TTL_DIAS=1

# --- Peças prontas (deixe vazio para não usar) ---
# Vault: a pasta é sempre ${ASSISTENTE_HOME}/vault. Aqui vai o caminho DENTRO do container:
# vazio desliga, /vault liga. Nenhum outro valor é aceito.
VAULT_PATH=
# Paperless-ngx (URL vista de dentro do container) e token da API
PAPERLESS_URL=
PAPERLESS_API_KEY=

# --- Backup e migração (scripts/exportar.sh) ---
# Chave PÚBLICA do age (age1...). A privada nunca fica no servidor (docs/MIGRACAO.md).
AGE_DESTINATARIO=
# Para onde vão os pacotes do backup diário. Vazio = ${ASSISTENTE_HOME}/backups (mesmo disco:
# não protege contra perda do disco; aponte para o HD externo montado).
BACKUP_DESTINO=
