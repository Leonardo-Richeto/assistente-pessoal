# Copie para ${FOTOS_HOME}/.env (fora do git), chmod 600, e preencha.
# Ficha 17 de docs/regras-de-negocio.md; roteiro em docs/IMPLANTACAO.md ("Fotos (10)").

# --- Onde mora o estado (biblioteca, banco, modelos). ---
FOTOS_HOME=/srv/fotos
COMPOSE_PROJECT_NAME=fotos
# Porta no loopback do host (conferência, túnel SSH e immich-go).
PORTA_HOST=8040
# Senha do Postgres do Immich, só letras e números (exigência do Immich): openssl rand -hex 24
DB_PASSWORD=

# Chave da API do Immich, do administrador, só com as permissões job.create e queue.read (ml.sh, janela do ML).
# Crie no Immich: foto do perfil → Configurações da conta → Chaves de API.
IMMICH_API_KEY=

# --- Rede de casa (Ficha 17, regra 2): IP fixo do i7 na rede local (reserva no DHCP do roteador). ---
# O app do iPhone usa http://<ENDERECO_LAN>:<PORTA_LAN>. Vazio = só loopback (teste no Mac).
ENDERECO_LAN=
PORTA_LAN=2283
# Não ponha "ml" aqui: o ML só sobe na janela semanal (Ficha 17, regra 6).
COMPOSE_PROFILES=
