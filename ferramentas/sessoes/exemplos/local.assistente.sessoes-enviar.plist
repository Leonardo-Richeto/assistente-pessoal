<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exemplo (NÃO instalado): envia a fila de sessões do Claude Code para o i7 a cada hora.
  Troque USUARIO pelo seu usuário do Mac e usuario@i7 pelo destino SSH. Como instalar: README.md, "Envio para o i7".
  Antes, crie a chave só do envio (~/.ssh/assistente_sessoes, restrita no i7 por command=) e aceite a host key à mão;
  o enviar.py usa essa chave sozinho. Para outra chave, acrescente ASSISTENTE_SSH_CHAVE com o caminho absoluto.
  O launchd não expande "~" nem "$HOME": use caminhos absolutos.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.assistente.sessoes-enviar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/USUARIO/Desktop/Projetos/assistente-pessoal/ferramentas/sessoes/enviar.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ASSISTENTE_SSH</key>
    <string>usuario@i7</string>
  </dict>
  <!-- A cada hora; com o Mac dormindo, roda uma vez ao acordar. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USUARIO/.local/state/assistente/sessoes/enviar-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USUARIO/.local/state/assistente/sessoes/enviar-launchd.log</string>
</dict>
</plist>
